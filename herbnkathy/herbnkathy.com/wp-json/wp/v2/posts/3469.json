herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.16.15-1024x576.jpg 1024w\" sizes=\"auto, (max-width: 760px) 100vw, 760px\" \/><\/a>\n\t\t\t<\/div>\n\t\t\t\t<figcaption class='wp-caption-text gallery-caption' id='gallery-1-3478'>\n\t\t\t\tThe peaks in the distance\n\t\t\t\t<\/figcaption><\/figure><figure class='gallery-item'>\n\t\t\t<div class='gallery-icon landscape'>\n\t\t\t\t<a href='https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.10.17.jpg'><img loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"428\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.10.17.jpg\" class=\"attachment-full size-full\" alt=\"\" aria-describedby=\"gallery-1-3479\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.10.17.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.10.17-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.10.17-768x432.jpg 768w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.10.17-1024x576.jpg 1024w\" sizes=\"auto, (max-width: 760px) 100vw, 760px\" \/><\/a>\n\t\t\t<\/div>\n\t\t\t\t<figcaption class='wp-caption-text gallery-caption' id='gallery-1-3479'>\n\t\t\t\tBeer cans haven&#8217;t been steel for years\n\t\t\t\t<\/figcaption><\/figure><figure class='gallery-item'>\n\t\t\t<div class='gallery-icon landscape'>\n\t\t\t\t<a href='https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.09.42.jpg'><img loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"428\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.09.42.jpg\" class=\"attachment-full size-full\" alt=\"\" aria-describedby=\"gallery-1-3480\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.09.42.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.09.42-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\