, 760px\" \/><\/a>\n\t\t\t<\/div>\n\t\t\t\t<figcaption class='wp-caption-text gallery-caption' id='gallery-1-3474'>\n\t\t\t\tJust a cool looking rock\n\t\t\t\t<\/figcaption><\/figure><figure class='gallery-item'>\n\t\t\t<div class='gallery-icon landscape'>\n\t\t\t\t<a href='https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.33.24.jpg'><img loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"428\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.33.24.jpg\" class=\"attachment-full size-full\" alt=\"\" aria-describedby=\"gallery-1-3475\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.33.24.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.33.24-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.33.24-768x432.jpg 768w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.33.24-1024x576.jpg 1024w\" sizes=\"auto, (max-width: 760px) 100vw, 760px\" \/><\/a>\n\t\t\t<\/div>\n\t\t\t\t<figcaption class='wp-caption-text gallery-caption' id='gallery-1-3475'>\n\t\t\t\tA little closer look at the peaks\n\t\t\t\t<\/figcaption><\/figure><figure class='gallery-item'>\n\t\t\t<div class='gallery-icon landscape'>\n\t\t\t\t<a href='https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.27.19.jpg'><img loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"428\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.27.19.jpg\" class=\"attachment-full size-full\" alt=\"\" aria-describedby=\"gallery-1-3476\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.27.19.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.27.19-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.27.19-768x432.jpg 768w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2017\/03\/2017-03-06-11.27.19-1024x576.jpg