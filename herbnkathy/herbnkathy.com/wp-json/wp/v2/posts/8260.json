athy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1014003171841787593557894056.jpg\" data-id=\"8282\" class=\"wp-image-8282\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1014003171841787593557894056.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1014003171841787593557894056-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1014003171841787593557894056-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1013243342717720607387637126.jpg\" data-id=\"8283\" class=\"wp-image-8283\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1013243342717720607387637126.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1013243342717720607387637126-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1013243342717720607387637126-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1012370597097556946907918577.jpg\" data-id=\"8284\" class=\"wp-image-8284\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1012370597097556946907918577.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1012370597097556946907918577-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/12\/img_20211213_1012370597097556946907918577-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" decoding=\"async\"