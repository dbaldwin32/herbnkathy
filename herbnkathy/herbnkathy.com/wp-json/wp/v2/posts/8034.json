-content\/uploads\/2021\/10\/IMG_20211005_102823181.jpg\"><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102823181.jpg\" alt=\"\" data-id=\"8045\" class=\"wp-image-8045\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102823181.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102823181-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102823181-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/a><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><a href=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102813443.jpg\"><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102813443.jpg\" alt=\"\" data-id=\"8046\" class=\"wp-image-8046\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102813443.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102813443-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102813443-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/a><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><a href=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102804158.jpg\"><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102804158.jpg\" alt=\"\" data-id=\"8047\" class=\"wp-image-8047\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102804158.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102804158-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102804158-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/a><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><a href=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102722898.jpg\"><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102722898.jpg\" alt=\"\" data-id=\"8048\" class=\"wp-image-8048\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102722898.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102722898-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102722898-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/a><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><a href=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102644086.jpg\"><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102644086.jpg\" alt=\"\" data-id=\"8049\" class=\"wp-image-8049\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102644086.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102644086-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_102644086-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/a><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><a href=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101734745.jpg\"><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101734745.jpg\" alt=\"\" data-id=\"8050\" class=\"wp-image-8050\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101734745.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101734745-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101734745-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/a><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><a href=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101132919.jpg\"><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101132919.jpg\" alt=\"\" data-id=\"8051\" class=\"wp-image-8051\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101132919.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101132919-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101132919-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/a><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><a href=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101140444.jpg\"><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101140444.jpg\" alt=\"\" data-id=\"8052\" class=\"wp-image-8052\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101140444.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101140444-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101140444-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/a><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><a href=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101217664.jpg\"><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101217664.jpg\" alt=\"\" data-id=\"8053\" class=\"wp-image-8053\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101217664.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101217664-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101217664-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/a><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><a href=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101625263.jpg\"><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"540\" src=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101625263.jpg\" alt=\"\" data-id=\"8054\" class=\"wp-image-8054\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101625263.jpg 720w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101625263-300x225.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2021\/10\/IMG_20211005_101625263-685x514.jpg 685w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" \/><\/a><figcaption class=\"blocks-gallery-item__caption\">Their kitchen for private parties<\/figcaption><\/figure><\/li><\/ul><\/figure>\n\n\n\n<p>Marco told us that it&#8217;s too bad we came in early morning and Charlie (Mr. Messenger) wasn&#8217;t there yet.  This has been a labor of love for the Messengers for many years and Charlie typically stops in daily to check up on the business and often chats with visitors about some of the displays giving the guests more insight on the history of the early west.<\/p>\n\n\n\n<p>After our visit we (of course) stopped for lunch and afterward we were nearly back to our camp in Pine Bluffs when my cell phone rang.  It was Charlie.  He was hoping to catch us before we were out of town so that we could visit a while.  <\/p>\n\n\n\n<p>It wouldn&#8217;t work this time, but we&#8217;ll be sure to leave <a href=\"https:\/\/www.cheyenne.org\/listing\/messenger-museum\/417\/\" target=\"_blank\" rel=\"noreferrer noopener\">Messengers Old West Museum<\/a> on our Bucket List for the next time we are anywhere near Cheyenne Wyoming.  And you should too!<\/p>\n\n\n\n<p>The museum is open Monday-Friday, 8:00am &#8211; 5:00pm, no admission charge, but donations are welcomed.<\/p>\n\n\n\n<p>That&#8217;s all for now, but more to come &#8230; thanks for riding along.  Take Care of yourselves and each other.<\/p>\n\n\n\n<p><\/p>\n\n\n\n<p>Herb &amp; Kathy<\/p>\n","protected":false},"excerpt":{"rendered":"<p>There&#8217;s a lot to see and do when visiting the Cheyenne \/ Laramie Wyoming area, but there&#8217;s more than a few hundred miles to go between now and Casa Grande, Arizona which is our target for November 1st. We knew we couldn&#8217;t see it all. We talked with our good friends Matt and Sherry because &hellip; <a href=\"https:\/\/herbnkathy.com\/2021\/10\/06\/tourist-review-the-messenger-museum-cheyenne-wyoming\/\" class=\"more-link\">Continue reading <span class=\"screen-reader-text\">Tourist Review &#8211; The Messenger Museum @ Cheyenne, Wyoming<\/span><\/a><\/p>\n","protected":false},"author":1,"featured_media":0,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[490,586,677,264,554708024,554707329],"tags":[554708059,554708070,554708067,554708066,554707683,554708064,554708022,554708060,554708061,554708068,554707284,554708069,554708062,554707769,23317,554707291,554708063,554708065,554707731],"class_list":["post-8034","post","type-post","status-publish","format-standard","hentry","category-animals","category-food","category-friends","category-learning","category-tourism-review","category-traveling","tag-antiques","tag-arrowheads","tag-bill-cody","tag-buffalo-bill","tag-car-museum","tag-carriage","tag-cheyenne","tag-collectibles","tag-collection","tag-harness","tag-horses","tag-knives","tag-marco","tag-messenger","tag-museum","tag-saddle","tag-storage","tag-wild-west","tag-wyoming"],"_links":{"self":[{"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/posts\/8034","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/comments?post=8034"}],"version-history":[{"count":6,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/posts\/8034\/revisions"}],"predecessor-version":[{"id":8096,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/posts\/8034\/revisions\/8096"}],"wp:attachment":[{"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/media?parent=8034"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/categories?post=8034"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/tags?post=8034"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}