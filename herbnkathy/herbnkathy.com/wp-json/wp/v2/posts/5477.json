ta-link=\"https:\/\/herbnkathy.com\/?attachment_id=5489\" class=\"wp-image-5489\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131354.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131354-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131354-768x432.jpg 768w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131354-1024x576.jpg 1024w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131354-685x385.jpg 685w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131354-2000x1125.jpg 2000w\" sizes=\"auto, (max-width: 760px) 100vw, 760px\" \/><figcaption>This &#8217;60&#8217;s era Chevy is ALL from sheet metal &#8211; all hand formed and welded!<\/figcaption><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"428\" src=\"https:\/\/i0.wp.com\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131405.jpg?fit=685%2C385&amp;ssl=1\" alt=\"\" data-id=\"5490\" data-link=\"https:\/\/herbnkathy.com\/?attachment_id=5490\" class=\"wp-image-5490\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131405.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131405-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131405-768x432.jpg 768w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131405-1024x576.jpg 1024w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131405-685x385.jpg 685w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131405-2000x1125.jpg 2000w\" sizes=\"auto, (max-width: 760px) 100vw, 760px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"428\" src=\"https:\/\/i0.wp.com\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131420.jpg?fit=685%2C385&amp;ssl=1\" alt=\"\" data-id=\"5491\" data-link=\"https:\/\/herbnkathy.com\/?attachment_id=5491\" class=\"wp-image-5491\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131420.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131420-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131420-768x432.jpg 768w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131420-1024x576.jpg 1024w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131420-685x385.jpg 685w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131420-2000x1125.jpg 2000w\" sizes=\"auto, (max-width: 760px) 100vw, 760px\" \/><figcaption>They use Toyota engines and drive trains<\/figcaption><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"428\" src=\"https:\/\/i2.wp.com\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131804.jpg?fit=685%2C385&amp;ssl=1\" alt=\"\" data-id=\"5492\" data-link=\"https:\/\/herbnkathy.com\/?attachment_id=5492\" class=\"wp-image-5492\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131804.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131804-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131804-768x432.jpg 768w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131804-1024x576.jpg 1024w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131804-685x385.jpg 685w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_131804-2000x1125.jpg 2000w\" sizes=\"auto, (max-width: 760px) 100vw, 760px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"428\" src=\"https:\/\/i1.wp.com\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133225.jpg?fit=685%2C385&amp;ssl=1\" alt=\"\" data-id=\"5493\" data-link=\"https:\/\/herbnkathy.com\/?attachment_id=5493\" class=\"wp-image-5493\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133225.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133225-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133225-768x432.jpg 768w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133225-1024x576.jpg 1024w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133225-685x385.jpg 685w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133225-2000x1125.jpg 2000w\" sizes=\"auto, (max-width: 760px) 100vw, 760px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"428\" src=\"https:\/\/i2.wp.com\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133413.jpg?fit=685%2C385&amp;ssl=1\" alt=\"\" data-id=\"5494\" data-link=\"https:\/\/herbnkathy.com\/?attachment_id=5494\" class=\"wp-image-5494\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133413.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133413-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133413-768x432.jpg 768w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133413-1024x576.jpg 1024w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133413-685x385.jpg 685w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_133413-2000x1125.jpg 2000w\" sizes=\"auto, (max-width: 760px) 100vw, 760px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"428\" src=\"https:\/\/i0.wp.com\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134313.jpg?fit=685%2C385&amp;ssl=1\" alt=\"\" data-id=\"5495\" data-link=\"https:\/\/herbnkathy.com\/?attachment_id=5495\" class=\"wp-image-5495\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134313.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134313-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134313-768x432.jpg 768w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134313-1024x576.jpg 1024w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134313-685x385.jpg 685w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134313-2000x1125.jpg 2000w\" sizes=\"auto, (max-width: 760px) 100vw, 760px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img loading=\"lazy\" decoding=\"async\" width=\"760\" height=\"428\" src=\"https:\/\/i1.wp.com\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134455.jpg?fit=685%2C385&amp;ssl=1\" alt=\"\" data-id=\"5496\" data-link=\"https:\/\/herbnkathy.com\/?attachment_id=5496\" class=\"wp-image-5496\" srcset=\"https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134455.jpg 760w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134455-300x169.jpg 300w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134455-768x432.jpg 768w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134455-1024x576.jpg 1024w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134455-685x385.jpg 685w, https:\/\/herbnkathy.com\/wp-content\/uploads\/2019\/02\/20190207_134455-2000x1125.jpg 2000w\" sizes=\"auto, (max-width: 760px) 100vw, 760px\" \/><figcaption>They roll the bumpers, grill, light rings, hub caps, tail pipes, body trim all out of stainless<\/figcaption><\/figure><\/li><\/ul>\n\n\n\n<p>Ernie and his buddies were there the day we visited &#8211; there were probably about 35 or 40 of us altogether. I asked one of them what their day is like. He said &#8220;we start work at the shop about 7am but then slow down (or quit altogether) when the visitors start to come in.&#8221; &#8220;Then we start up again late afternoon and work until 8 or 9 at night.&#8221;  When asked how many hours it takes to make one of these beauties he answered &#8220;about 3000&#8221; or so.<\/p>\n\n\n\n<p>I commented on how dedicated they are to spend those kinds of hours each day toward achieving the finished product.  One of them piped up and said &#8220;but only for 6 months &#8211; then I go home to Minnesota&#8221;.  My reaction was one of relief and I commented &#8220;that&#8217;s good that you get a vacation from this&#8221; and he replied &#8220;yeah, I go back home to my shop in Minnesota and work on my projects there.&#8221;<\/p>\n\n\n\n<p>There is no fee to visit the &#8220;museum&#8221; but they do accept donations. There is an endless loop video playing in a little theater that shows how these cars are made from the ground up. Seeing this video really gave me an appreciation for all the talent, imagination, and effort that goes into producing these masterpieces. These guys are truly artisans.<\/p>\n\n\n\n<p>If you find yourself in the Phoenix or Tucson take a drive to the <a href=\"https:\/\/www.dwarfcarmuseum.com\/\" target=\"_blank\" rel=\"noreferrer noopener\" aria-label=\"Dwarf Car Museum (opens in a new tab)\">Dwarf Car Museum<\/a> at Maricopa.  You&#8217;ll be amazed at what you&#8217;ll see and even more so when you talk with the fellas that make these little wonders.<\/p>\n\n\n\n<p>To see all the pix from our time there, you can follow this <a rel=\"noreferrer noopener\" aria-label=\"Google Photo Album link (opens in a new tab)\" href=\"https:\/\/photos.app.goo.gl\/yUpwFGAn3bhj19Yk6\" target=\"_blank\">Google Photo Album link<\/a><\/p>\n\n\n\n<figure class=\"wp-block-embed-youtube wp-block-embed is-type-video is-provider-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\nhttps:\/\/youtu.be\/hbIpeElBO70\n<\/div><figcaption>Ernie&#8217;s Video<\/figcaption><\/figure>\n","protected":false},"excerpt":{"rendered":"<p>Once or twice each month we (folks here at Rover&#8217;s Roost RV Park) have what we call a &#8220;Tag Along&#8221;. We just hop in our car (or someone else&#8217;s) and head out on a road trip. This month about 10 or 12 of us went up to the Dwarf Car Museum just southwest of Maricopa, &hellip; <a href=\"https:\/\/herbnkathy.com\/2019\/02\/11\/how-do-they-make-those\/\" class=\"more-link\">Continue reading <span class=\"screen-reader-text\">How Do They Make Those?<\/span><\/a><\/p>\n","protected":false},"author":1,"featured_media":0,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[677,264,19546,554707329],"tags":[24592,554707679,554707676,554707683,554707678,554707677,554707684,554707661,554707660,554707680,554707682,23317,554707681],"class_list":["post-5477","post","type-post","status-publish","format-standard","hentry","category-friends","category-learning","category-sightseeing","category-traveling","tag-arizona","tag-artisan","tag-car","tag-car-museum","tag-chevy","tag-dwarf-car","tag-dwarf-car-museum","tag-herbnkathyrv","tag-herbsells","tag-maricopa","tag-metal-shop","tag-museum","tag-shop"],"_links":{"self":[{"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/posts\/5477","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/comments?post=5477"}],"version-history":[{"count":6,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/posts\/5477\/revisions"}],"predecessor-version":[{"id":5504,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/posts\/5477\/revisions\/5504"}],"wp:attachment":[{"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/media?parent=5477"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/categories?post=5477"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/herbnkathy.com\/wp-json\/wp\/v2\/tags?post=5477"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}